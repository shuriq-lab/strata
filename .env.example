# Optional. Leave unset to run the local Artifacts adapter (the default).
# ARTIFACTS_DRIVER=local

# Real Cloudflare Artifacts. Do not commit real values.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# ARTIFACTS_NAMESPACE=default

# Optional narration over the scripted answers. The demo does not need this.
# OPENAI_API_KEY=
# STRATA_LLM_MODEL=gpt-4o-mini
